% Verified by READING arXiv:2405.02437v3 + USENIX Security '25 (pp. 2733-2752).
% THIS is the precedent for our message format, not k-FED. The paper studies k-means "in the
% horizontally federated setting" and its per-round protocol aggregates exactly (sums, counts):
%   "we privately aggregate (sum) the local updates of all clients, perturb the result, and
%    reveal the noisy global relative sums and counts for the next round"
% and it describes the plain version as "summing sums and counts across clients. While this is
% very efficient in practice, it reveals aggregate intermediate values to all clients" -- i.e.
% it also documents the leakage caveat we acknowledge in \S sec:fed-threat. It applies SECURE
% AGGREGATION to that same (sums, counts) pair, which is the precedent for our SecAgg claim.
@inproceedings{diaa2025fastlloyd,
  title     = {{FastLloyd}: Federated, Accurate, Secure, and Tunable $k$-Means Clustering with Differential Privacy},
  author    = {Diaa, Abdulrahman and Humphries, Thomas and Kerschbaum, Florian},
  booktitle = {USENIX Security Symposium},
  pages     = {2733--2752},
  year      = {2025},
  note      = {arXiv:2405.02437}
}

% Verified by reading research.google/blog/federated-analytics-...: federated analytics is
% "the practice of applying data science methods to the analysis of raw data that is stored
% locally on users' devices", it computes "counts or rates", and in the Now Playing example
% secure aggregation means the server sees only "the final tally of all song counts (and
% nothing else)". A blog post, but it is the origin of the term; paired with the peer-reviewed
% bonawitz2022privacy for the formal framing.
@misc{ramage2020fedanalytics,
  title        = {Federated Analytics: Collaborative Data Science without Data Collection},
  author       = {Ramage, Daniel and Mazzocchi, Stefano},
  howpublished = {Google Research Blog},
  year         = {2020},
  note         = {27 May 2020}
}

