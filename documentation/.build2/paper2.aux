\@writefile{lot}{\contentsline {table}{\numberline {I}{\ignorespaces Configurations evaluated. ``FedAvg'' is count-weighted parameter averaging, ``pooled'' the aggregation of BN statistics, ``suff.\,stat.'' the codebook update of~\eqref  {eq:suffstat}, ``partial'' the shared prior with client-specific components local. $n$ = development series run and, in parentheses, coverage of the four that separate the arms at all (Section~\ref {subsec:discriminating}), so $4/4$ is a complete cover.}}{3}{table.1}\protected@file@percent }
\newlabel{tab:space}{{I}{3}{Configurations evaluated. ``FedAvg'' is count-weighted parameter averaging, ``pooled'' the aggregation of BN statistics, ``suff.\,stat.'' the codebook update of~\eqref {eq:suffstat}, ``partial'' the shared prior with client-specific components local. $n$ = development series run and, in parentheses, coverage of the four that separate the arms at all (Section~\ref {subsec:discriminating}), so $4/4$ is a complete cover}{table.1}{}}
